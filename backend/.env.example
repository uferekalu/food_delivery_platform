# development | test | production
NODE_ENV=development

PORT=4000

# MongoDB Atlas connection string (create a free cluster at https://www.mongodb.com/cloud/atlas)
MONGODB_URI=mongodb://localhost:27017/food_delivery_platform

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:3000

# Base URL of the frontend app, used to build links in verification/reset emails
FRONTEND_URL=http://localhost:3000

# Generate with: openssl rand -base64 48  (each must be at least 32 characters, and different
# from one another — a leaked access secret shouldn't compromise refresh/email tokens too)
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-chars
JWT_REFRESH_EXPIRES_IN=30d
JWT_EMAIL_SECRET=replace-with-yet-another-random-secret-at-least-32-chars

# Resend (https://resend.com) API key, for verification/password-reset emails
RESEND_API_KEY=re_your_api_key
MAIL_FROM=Food Delivery Platform <noreply@yourdomain.com>

# Cloudinary (https://cloudinary.com — free tier is plenty for dev). Dashboard home page
# shows all three. Used to sign direct-to-Cloudinary uploads (restaurant/menu images) —
# the binary never passes through this server.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Stripe (https://dashboard.stripe.com/test/apikeys) — test-mode secret key. Webhook secret
# comes from either a dashboard-configured webhook endpoint or `stripe listen` (Stripe CLI) for
# local dev, since Stripe can't reach localhost directly.
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Paystack (https://dashboard.paystack.com/#/settings/developer) — test-mode secret key.
# Signature verification uses this same key (HMAC-SHA512 of the raw webhook body), no separate
# webhook secret.
PAYSTACK_SECRET_KEY=sk_test_your_key

# Flutterwave (https://app.flutterwave.com/dashboard/settings/apis) — test-mode secret key,
# plus the static webhook "secret hash" you set under Settings > Webhooks (Flutterwave echoes
# this back verbatim in the verif-hash header; it is not an HMAC).
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-your_key
FLUTTERWAVE_WEBHOOK_HASH=your_webhook_hash
