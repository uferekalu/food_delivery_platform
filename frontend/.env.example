# Base URL of the backend API. Local dev default matches the NestJS backend's default port.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional — powers the live delivery map on the order tracking page (docs/ARCHITECTURE.md
# §10). Leave unset and the map degrades gracefully to the status stepper only; nothing else
# in the app depends on this being configured.
NEXT_PUBLIC_MAPBOX_TOKEN=

# This app's own public URL — used for canonical/OG metadata, sitemap.xml, and robots.txt
# (docs/ROADMAP.md FDP-21). Set to the real production URL in Vercel; local dev default below.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
